msgstr "Rimescolazione Squadre Automatica"

#. Key:	Setting_Server_AllowAutoScramble_Tooltip
#. SourceLocation:	/Game/StringTables/ST_Settings.ST_Settings
#: /Game/StringTables/ST_Settings.ST_Settings
msgctxt "ST_Settings,Setting_Server_AllowAutoScramble_Tooltip"
msgid "Allow the game to automatically scramble teams when they are considered unbalanced."
msgstr "Permetti al gioco di rimescolare le squadre automaticamente quando le ritiene non bilanciate."

#. Key:	Setting_Server_AllowPlayersToChangeTeams
