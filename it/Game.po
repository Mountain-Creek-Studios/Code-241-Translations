#. Key:	Tip_Bullseye
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Bullseye"
msgid "Wanna train your aim? Try \"Tr_Bullseye\" for a challenge!"
msgstr "Vuoi allenare la tua mira? Prova \"Tr_Bullseye\" per una sfida!"

#. Key:	Tip_CannotPickup
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_CannotPickup"
msgid "Some weapons are incompatible with the class or character you play. Check the weapons available in your class loadout to see which guns are compatible!"
msgstr "Alcune armi sono incompatibili con la classe o il personaggio che stai giocando. Dai un occhiata al menu d'equipaggiamento della tua classe per vedere le armi compatibili."

#. Key:	Tip_ChangeTeam
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_ChangeTeam"
msgid "Change your team by pressing \"#@INPUT_CHANGETEAM#\"."
msgstr "Cambia la tua squadra premendo \"#INPUT_CHANGETEAM#\"."

#. Key:	Tip_Coalition_Stock_AmmoSwap
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Coalition_Stock_AmmoSwap"
msgid "The Stock has different ammo types! Press \"#@INPUT_SECONDARYATTACK#\" to swap between them - light ammo for close quarters and heavy for mid-to-long range firefights."
msgstr "Il Fucile di Scorta ha due tipi di munizioni diverse! Premi \"#@INPUT_SECONDARYATTACK#\" per scambiarle: colpi leggeri per il combattimento ravvicinato e colpi pesanti per la media-lunga distanza."

#. Key:	Tip_Coalition_Syringe_SelfInject
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Coalition_Syringe_SelfInject"
msgid "You can inject syringes into yourself at double the cost - press \"#@INPUT_ABILITY#\" whilst having them out to try that - or, if you can, just ask another medic to help you out."
msgstr "Puoi iniettarti le tue stesse siringhe al doppio del costo. Premi \"#@INPUT_ABILITY#\" per provare, oppure chiama un altro medico per farti aiutare, sempre che tu ci riesca."

#. Key:	Tip_Coalition_Syringe_Throw
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Coalition_Syringe_Throw"
msgid "You can throw syringes! Try pressing \"#@INPUT_SECONDARYATTACK#\" to heal or hurt people at a distance!"
msgstr "Le tue siringhe possono essere lanciate! Prova a premere \"#@INPUT_SECONDARYATTACK#\" per curare o danneggiare altri giocatori a distanza."

#. Key:	Tip_Countering_Nancoids
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Countering_Nancoids"
msgid "The Nancoid faction is designed around specialized attacker types. Support keeps open areas off-limits, Stormtroopers clear obstacles and barricades, officers pick off targets of opportunity. Target one of these and take advantage once you've got an opening."
msgstr ""

#. Key:	Tip_Countersniping
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Countersniping"
msgid "Weapons like the LMG use firepower as both their sword and shield. If you can pull it off without dying yourself, accurate return fire with the right type of gun can end that fight quite quickly."
msgstr ""

#. Key:	Tip_CriticalHits
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_CriticalHits"
msgid "Some weapons, like the Varga on headshot, deal critical hits. Critical hits are simple: They just double the damage!"
msgstr "Alcune armi, come il Varga quando colpisce alla testa, infliggono danni critici. I colpi critici sono semplici: Raddoppiano semplicemente il danno!"

#. Key:	Tip_CrouchAim
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_CrouchAim"
msgid "Crouching does absolutely nothing to improve your aim!"
msgstr "Accovacciarti garantisce un aumento della precisione dello 0.000000%!"

#. Key:	Tip_DamageFalloff
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_DamageFalloff"
msgid "Weapons usually deal more damage the closer you are to the target, though some exceptions exist. Be sure to take a look at your weapon's stats to see if any special rules apply!"
msgstr ""

#. Key:	Tip_Deathmatch
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Deathmatch"
msgid "In Deathmatch, it’s everybody against everybody. Avoid open areas and chokepoints, and always be on your guard."
msgstr "In Deathmatch, tutti sono contro tutti. Evita le aree aperte e le strettoie, e tieni sempre la guardia alta."

#. Key:	Tip_EnemyWeapons
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_EnemyWeapons"
msgid "You cannot pick up enemy guns. If you try to pick them up, they will be converted to a medium ammo pack instead."
msgstr "Non puoi raccogliere le armi nemiche. Se provi a raccoglierle, verranno convertite in un kit di munizioni medio."

#. Key:	Tip_Frontilne
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Frontilne"
msgid "In Frontline, the fight goes sector-by-sector. Split your team between pushing the enemy off the control points and guarding the ones you already have."
msgstr "In Prima Linea, la battaglia si sviluppa settore dopo settore. Separa la tua squadra tra scacciare i nemici dal punto di controllo e difendere quelli che hai già catturato."

#. Key:	Tip_GettingRolled
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_GettingRolled"
msgid "If you’re getting rolled, your only saving grace might be you becoming the change you want to see in the team."
msgstr "Se stai perdendo, la tua unica salvezza potrebbe essere diventare il cambiamento che vorresti vedere nella tua squadra."

#. Key:	Tip_Grenades
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Grenades"
msgid "All grenades feature a red light that blinks faster the closer they are to detonation. If the light is solid, they will explode on impact."
msgstr "Ogni granata ha una luce rossa che lampeggia più velocemente quanto più è vicina alla detonazione. Se la luce è fissa, esploderà all'impatto."

#. Key:	Tip_Hydrate
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Hydrate"
msgid "Remember to hydrate!"
msgstr "Ricordati di bere!"

#. Key:	Tip_HydrationBreak
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_HydrationBreak"
msgid "Hydration break soon?"
msgstr "Quando si fa una pausa? Non hai sete?"

#. Key:	Tip_Koth
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Koth"
msgid "In King of the Hill, there is only one control point. Take it and then keep the enemy as far away as possible. Spawn-camp them if needed."
msgstr "In Re della Collina, c'è un solo punto di controllo. Catturalo e tieni il nemico più lontano possibile. Infesta il suo punto di spawn se necessario."

#. Key:	Tip_LoadoutKey
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_LoadoutKey"
msgid "Change your loadout by pressing \"#@INPUT_LOADOUT#\"."
msgstr "Cambia il tuo equipaggiamento premendo \"#@INPUT_LOADOUT#\"."

#. Key:	Tip_Medkit
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Medkit"
msgid "Tough fight ahead? Grab a medkit - if it heals you to more than full health, you can be temporarily overhealed up to 200% of your base health."
msgstr "Scontro in arrivo? Prendi un kit medico, se la cura va oltre la tua salute massima, puoi essere sovracurato fino al 200% della tua salute massima."

#. Key:	Tip_MindAmmo
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_MindAmmo"
msgid "Mind the ammo economy! Some weapons don’t have the bullet reserve to just shoot around mindlessly."
msgstr "Tieni d'occhio le munizioni! Non tutte le armi hanno abbastanza proiettili per sparare a caso."

#. Key:	Tip_MoveForward
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_MoveForward"
msgid "Press \"#@INPUT_MOVE_FORWARD#\" to move forward."
msgstr "Premi \"#@INPUT_MOVE_FORWARD#\" per muoverti in avanti."

#. Key:	Tip_Nancoids_BewareVarga
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_BewareVarga"
msgid "Beware of snipers! In the right hands, the Varga can deal devastating damage, so mind your positioning."
msgstr "Attenzione ai cecchini! Nelle giuste mani il Varga può essere letale, perciò tieni gli occhi aperti."

#. Key:	Tip_Nancoids_BrassTack
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_BrassTack"
msgid "The Brass Tack deals devastating damage at mid-to-close range, but has quite some recoil. Unless you’re very close, try firing in 5-round bursts for optimal ammo efficiency!"
msgstr "La Puntina d'Ottone è devastante nel combattimento a media-corta distanza, ma ha un bel pò di rinculo. Almeno che tu non sia molto vicino, prova a sparare in serie da 5 colpi per risparmiare munizioni."

#. Key:	Tip_Nancoids_FlamerNearby
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_FlamerNearby"
msgid "Be very careful around smoke grenades - it usually means there is a flamer nearby."
msgstr "Fa attenzione ad aggirarti vicino alle granate fumogene, solitamente significa che c'è un Lanciafiamme nei dintorni."

#. Key:	Tip_Nancoids_LMG
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_LMG"
msgid "The LMG deals extra damage to targets that are far away - use this to your advantage if the enemy is holding in an open area!"
msgstr "La Mitragliatrice fa molto più danno da lontano. Usala a tuo vantaggio se il nemico difende una zona aperta."

#. Key:	Tip_Nancoids_LMG_Recoil
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_LMG_Recoil"
msgid "The LMG stops having recoil if you fire it for long enough. If you’ve got the ammo to spare, you can deal devastating damage across the map."
msgstr "Più continui a sparare con la Mitragliatrice più lei diventa precisa, fino a smettere completamente di avere rinculo. Spendendo abbastanza munizioni potrai infliggere colpi potenti e precisi da molto lontano."

#. Key:	Tip_Nancoids_SmokeBombs
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Nancoids_SmokeBombs"
msgid "If the Coalition deploys their characteristic smoke grenades and you have the ammo to spare, try firing wildly into the smoke! With enough firepower, you can deny a smoke entirely."
msgstr "Se la Coalizione schiera le sue tipiche granate fumogene e hai abbastanza munizioni, prova a sparare alla ceca nel fumo! Prima o poi colpirai qualcuno, no?"

#. Key:	Tip_Posture
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Posture"
msgid "Posture check."
msgstr "Occhio alla postura!"

#. Key:	Tip_PublicChat
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_PublicChat"
msgid "Open public-chat by pressing \"#@INPUT_CHAT_PUBLIC#\"."
msgstr "Apri la chat pubblica premendo \"#@INPUT_CHAT_PUBLIC#\"."

#. Key:	TIp_Scoreboard
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,TIp_Scoreboard"
msgid "View the scoreboard by pressing \"#@INPUT_SCOREBOARD#\"."
msgstr "Guarda il tabellone premendo \"#@INPUT_SCOREBOARD#\"."

#. Key:	Tip_SitWell
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_SitWell"
msgid "Remember to sit upright. Your back thanks you."
msgstr "Ricorda di sederti dritto. La tua schiena ringrazia."

#. Key:	Tip_Syringes
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_Syringes"
msgid "Syringes have zero addictive properties!"
msgstr "Le siringhe non causano alcuna dipendenza!"

#. Key:	Tip_TakeABreak
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_TakeABreak"
msgid "Take breaks."
msgstr "Fai delle pause."

#. Key:	Tip_TeamChat
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_TeamChat"
msgid "Open team-chat by pressing \"#@INPUT_CHAT_TEAM#\"."
msgstr "Apri la chat di squadra premendo \"#@INPUT_CHAT_TEAM#\"."

#. Key:	Tip_WeaponActions
#. SourceLocation:	/Game/StringTables/ST_Tips.ST_Tips
#: /Game/StringTables/ST_Tips.ST_Tips
msgctxt "ST_Tips,Tip_WeaponActions"
msgid "Most weapons have a primary, secondary and special attack! Try pressing \"#@INPUT_PRIMARYATTACK#\", \"#@INPUT_SECONDARYATTACK#\" and \"#@INPUT_ABILITY#\" to see what happens!"
msgstr "La maggior parte delle armi hanno un attacco primario, secondario e un'abilità! Prova a premere \"#@INPUT_PRIMARYATTACK#\", \"#@INPUT_SECONDARYATTACK#\" e \"#@INPUT_ABILITY#\" per vedere che succede!"

